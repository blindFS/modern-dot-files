#!/usr/bin/env bash

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/plugins"

source "$PLUGIN_DIR/style.sh"

# Default configuration settings
default_args=(
  align=center
  updates=when_shown
  padding_left=2
  padding_right=2
  icon.font="$MONOFONT:Bold:17.0"
  label.font="$MONOFONT:Bold:12.0"
  icon.color="$COLOR_WHITE"
  label.color="$COLOR_FG"
  icon.padding_left=8
  icon.padding_right=2
  label.padding_left=2
  label.padding_right=8
  background.corner_radius=10
  background.color="$COLOR_BG"
  background.border_width=1
  background.border_color="$COLOR_BG"
)

workspace_default_args=(
  icon.font.size=12
  label.font.size=17
  label.shadow.drawing=on
  label.shadow.color="$COLOR_BG"
  label.shadow.distance=3
  label.highlight_color="$COLOR_GREEN"
  background.drawing=off
  background.color="$COLOR_TRANSPARENT"
  background.border_width=2
  background.border_color="$COLOR_FG"
  background.shadow.drawing=on
  background.shadow.color="$COLOR_BG"
  background.shadow.distance=3
)

# Start building sketchybar arguments
cmd=(
  --bar position=top height=25 blur_radius=20 color=0x00000000
  --add event aerospace_mode_change
  --add event aerospace_workspace_change
  --add event my_media_change
  --default "${default_args[@]}"
)

# Populate Aerospace workspace items
if command -v aerospace &>/dev/null; then
  for id in $(aerospace list-workspaces --all); do
    cmd+=(
      --add item "space.$id" left
      --set "space.$id" icon="$id" click_script="aerospace workspace $id" "${workspace_default_args[@]}"
    )
  done
fi

# Populate plugin items
cmd+=(
  # ws_listener
  --add item ws_listener left
  --subscribe ws_listener aerospace_workspace_change space_windows_change
  --set ws_listener updates=on drawing=off script="$PLUGIN_DIR/aerospace.sh"

  # front_app
  --add item front_app left
  --subscribe front_app front_app_switched aerospace_mode_change
  --set front_app label.color="$COLOR_BLACK" icon.color="$COLOR_BLACK" icon.font.size=20 background.color="$COLOR_BLUE" background.corner_radius=3 background.shadow.drawing=on background.shadow.color="$COLOR_BG" background.shadow.distance=3 script="$PLUGIN_DIR/front_app.sh"

  # media
  --add item media left
  --subscribe media my_media_change
  --set media icon="󰐎" icon.color="$COLOR_FG" label.color="$COLOR_FG" background.color="$COLOR_BG" background.border_color="$COLOR_FG" script="$PLUGIN_DIR/media.sh"

  # media_cover
  --add item media_cover left
  --subscribe media_cover my_media_change
  --set media_cover icon.drawing=off label.drawing=off background.image.drawing=on background.image=media.artwork background.image.scale=0.05 background.color="$COLOR_TRANSPARENT" background.border_width=0

  # clock
  --add item clock right
  --set clock update_freq=30 icon="" script="$PLUGIN_DIR/clock.sh" background.corner_radius=3 padding_right=1 padding_left=1 label.font.size=10

  # volume
  --add item volume right
  --subscribe volume volume_change
  --set volume script="$PLUGIN_DIR/volume.sh" background.corner_radius=3 padding_right=1 padding_left=1

  # battery
  --add item battery right
  --subscribe battery system_woke power_source_change
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" click_script="open x-apple.systempreferences:com.apple.preference.battery" background.corner_radius=3 padding_right=1

  # separator_right
  --add item separator_right right
  --set separator_right icon="" padding_left=0 label.drawing=off background.drawing=off click_script="$PLUGIN_DIR/toggle_stats.sh"

  # disk
  --add item disk right
  --set disk icon="󰋊" update_freq=120 script="$PLUGIN_DIR/disk.sh" click_script='open -a "Disk Utility"' icon.color="$COLOR_GREEN" background.border_color="$COLOR_GREEN"

  # cpu
  --add item cpu right
  --set cpu icon="" update_freq=10 script="$PLUGIN_DIR/cpu.sh" click_script='open -a "Activity Monitor"' icon.color="$COLOR_YELLOW" background.border_color="$COLOR_YELLOW"

  # memory
  --add item memory right
  --set memory icon="" update_freq=10 script="$PLUGIN_DIR/mem.sh" click_script='open -a "Activity Monitor"' icon.color="$COLOR_CYAN" background.border_color="$COLOR_CYAN"

  # temp_cpu
  --add item temp_cpu right
  --set temp_cpu icon="" label.font.size=7 label.y_offset=-4 icon.font.size=16 update_freq=5 padding_left=-58 script="$PLUGIN_DIR/temp.sh" click_script="$PLUGIN_DIR/popups/temp.sh" popup.align=left popup.background.border_width=2 popup.background.corner_radius=3 popup.background.border_color="$COLOR_YELLOW" popup.background.drawing=on
  --add item temp_fan1 popup.temp_cpu
  --set temp_fan1 label="unk" icon="󱑲"
  --add item temp_power popup.temp_cpu
  --set temp_power label="unk" icon="󰠠"

  # temp_gpu
  --add item temp_gpu right
  --set temp_gpu label.font.size=7 padding_left=0 padding_right=0 icon.font.size=16 icon.drawing=off label.y_offset=4 background.drawing=off

  # network_down
  --add item network_down right
  --set network_down icon="󰖩" label.font.size=7 label.y_offset=-4 update_freq=3 padding_left=-72 padding_right=23 script="$PLUGIN_DIR/network.sh" icon.color="$COLOR_PURPLE" label.highlight_color="$COLOR_PURPLE" background.border_color="$COLOR_PURPLE"

  # network_up
  --add item network_up right
  --set network_up label.font.size=7 padding_left=0 padding_right=0 icon.drawing=off label.y_offset=4 background.drawing=off label.highlight_color="$COLOR_PURPLE"
)

# Execute configuration command
sketchybar "${cmd[@]}"
sketchybar --update
